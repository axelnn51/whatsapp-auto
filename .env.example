# ============================================
# WhatsApp Cloud API (Meta)
# ============================================
# Obtener en: https://developers.facebook.com → Tu App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=tu_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=un_secreto_aleatorio_que_tu_elijas

# ============================================
# Inteligencia Artificial (Opcional pero Recomendado)
# ============================================
# Si un mensaje no matchea ningún flujo, puede usar IA para responder
# Obtén tu API Key gratis aquí: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_google_aqui

# ============================================
# Información del Negocio
# ============================================
BUSINESS_NAME=CDKeysPeru
BUSINESS_DESCRIPTION=Venta de licencias digitales originales: Windows, Office, antivirus y más
BUSINESS_WEBSITE=https://cdkeysperu.com
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=22
BUSINESS_TIMEZONE=America/Lima

# ============================================
# Humanización
# ============================================
# Delay antes de marcar como leído (segundos)
READ_DELAY_MIN=1
READ_DELAY_MAX=3

# Delay de "escribiendo..." antes de enviar respuesta (segundos)
TYPING_DELAY_MIN=7
TYPING_DELAY_MAX=15

# Delay entre mensajes cuando se divide la respuesta (segundos)
SPLIT_DELAY_MIN=2
SPLIT_DELAY_MAX=5

# Probabilidad de dividir mensaje largo en partes (0.0 a 1.0)
SPLIT_PROBABILITY=0.3

# ============================================
# Base de Datos
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_auto
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=cambia_esta_password_segura

# ============================================
# Admin Panel
# ============================================
ADMIN_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_este_password

# ============================================
# Cloudflare Tunnel (para exponer webhook)
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=tu_tunnel_token_aqui
